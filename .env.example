# ---------------------------------------------------------------- database
# Local development uses the embedded PostgreSQL started by scripts/dev/dev.mjs.
DATABASE_URL=postgres://cipherforge:cipherforge@127.0.0.1:54329/cipherforge
CF_PG_PORT=54329

# ------------------------------------------------------------- platform core
# Sign cookies, derive seed material and sign runner calls. Use 32+ random bytes.
CF_APP_SECRET=change-me-32-bytes-minimum-please
CF_RUNNER_SECRET=change-me-too-shared-with-the-runner
CF_ENV=development
CF_PORT=5000
# Public origin used for cookie scope and CORS in non-dev deployments.
CF_PUBLIC_ORIGIN=http://127.0.0.1:5000

# --------------------------------------------------------------- lab runner
CF_RUNNER_URL=http://127.0.0.1:7100
CF_RUNNER_PORT=7100
CF_RUNNER_BIND=127.0.0.1
# sandbox  = namespaces on this host (no Docker required)
# docker   = containers on a dedicated worker
CF_DRIVER=sandbox
CF_RUNTIME_DIR=~/.cache/cipherforge
CF_MAX_SESSIONS=8
CF_MAX_SESSIONS_PER_USER=2
# Sessions a learner may start per hour (QA harness rotates accounts instead).
CF_PROVISION_PER_HOUR=12

# -------------------------------------------------------------------- seeds
CF_SEED_ADMIN_EMAIL=admin@cipherforge.dev
CF_SEED_ADMIN_PASSWORD=AdminForge!2024
CF_SEED_LEARNER_EMAIL=learner@cipherforge.dev
CF_SEED_LEARNER_PASSWORD=CipherForge!2024

# --------------------------------------------------------------- embeddings
# Hostname suffixes allowed to iframe the app (cloud preview environments).
# Defaults to .e2b.app outside production; leave empty in production.
# CF_PREVIEW_FRAME_HOSTS=.e2b.app
# Set to * to accept framing from any ancestor on those preview hosts only.
# CF_PREVIEW_FRAME_ANCESTORS=*

# -------------------------------------------------------------------- flags
# How long a lab session may stay idle before the watchdog expires it.
CF_IDLE_TIMEOUT_MINUTES=20

# -------------------------------------------------------------------- debug
# Keep failed session runtime dirs on the runner for inspection.
# CF_KEEP_FAILED_SESSIONS=1

# ------------------------------------------------------------ integrations
# Outbound SMTP/SSO are not implemented; leave empty.
